{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent routing catalog (.agents/10-contracts/routing-catalog.yaml)",
  "type": "object",
  "required": ["version", "default_policy", "activities"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "default_policy": {
      "type": "object",
      "required": ["mode", "rule"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "fail-closed" },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "activities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["intent", "profile", "triggers", "first_surfaces", "escalation_order"],
        "additionalProperties": false,
        "properties": {
          "intent": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "first_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "escalation_order": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

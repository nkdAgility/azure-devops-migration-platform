{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consent policy (.agents/10-contracts/consent-policy.yaml)",
  "type": "object",
  "required": ["version", "operator_consent"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "operator_consent": {
      "type": "object",
      "required": ["required_for", "evidence", "block_if_missing"],
      "additionalProperties": false,
      "properties": {
        "required_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "block_if_missing": { "const": true },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

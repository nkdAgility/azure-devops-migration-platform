{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consent policy (.agents/10-contracts/consent-policy.yaml)",
  "type": "object",
  "required": ["version", "operator_consent"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "operator_consent": {
      "type": "object",
      "required": ["required_for", "evidence", "block_if_missing"],
      "additionalProperties": false,
      "properties": {
        "required_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "block_if_missing": { "const": true },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "standing_authorisations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["granted_by", "granted_on", "scope", "permits", "does_not_permit"],
        "additionalProperties": false,
        "properties": {
          "granted_by": { "type": "string", "minLength": 1 },
          "granted_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "status": { "type": "string" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workflows": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "permits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "does_not_permit": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}

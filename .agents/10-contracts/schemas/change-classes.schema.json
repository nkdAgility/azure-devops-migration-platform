{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change classes (.agents/10-contracts/change-classes.yaml)",
  "type": "object",
  "required": ["version", "classes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "classes": {
      "type": "object",
      "required": ["A", "B", "C"],
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/$defs/changeClass" },
        "B": { "$ref": "#/$defs/changeClass" },
        "C": { "$ref": "#/$defs/changeClass" }
      }
    }
  },
  "$defs": {
    "changeClass": {
      "type": "object",
      "required": ["name", "definition", "required_evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

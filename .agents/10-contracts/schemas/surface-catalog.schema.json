{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surface catalog (.agents/10-contracts/surface-catalog.yaml)",
  "type": "object",
  "required": ["version", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["concern", "surface", "owners", "allowed_callers", "forbidden"],
        "additionalProperties": false,
        "properties": {
          "concern": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "contract_doc": { "type": "string", "pattern": "^\\.agents/" },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "allowed_callers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}

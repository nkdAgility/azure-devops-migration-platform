    "map": {
      "cli-command": [
        "docs/cli-guide.md",
        ".agents/30-context/domains/cli-commands.md"
      ],
      "configuration": [
        "docs/configuration-reference.md"
      ],
      "module": [
        "docs/module-development-guide.md"
      ],
      "job-or-worker": [
        "docs/agent-hosting.md",
        ".agents/30-context/domains/job-lifecycle.md"
      ],
      "connector": [
        "docs/capabilities-guide.md"
      ],
      "package-layout": [
        ".agents/30-context/domains/migration-package-concept.md"
      ],
      "workitems-folder": [
        ".agents/30-context/domains/workitems-format-summary.md"
      ],
      "streaming-import": [
        ".agents/30-context/domains/import-streaming.md"
      ],
      "checkpointing": [
        ".agents/30-context/domains/checkpointing-summary.md"
      ],
      "package-and-state-stores": [
        ".agents/30-context/domains/package-manager.md"
      ],
      "telemetry": [
        ".agents/30-context/domains/telemetry-model.md"
      ],
      "identity-mapping": [
        ".agents/30-context/domains/identity-and-mapping.md"
      ],
      "aspire": [
        "docs/development-setup.md"
      ],
      "control-plane-api": [
        "docs/control-plane.md"
      ],
      "orchestration": [
        "docs/migration-process-guide.md"
      ],
      "tui": [
        "docs/tui-guide.md"
      ],
      "validation": [
        "docs/validation.md"
      ],
      "packaging": [
        "docs/package-format-reference.md"
      ],
      "architecture-decision": [
        "docs/architecture.md"
      ],
      "schema-generation": [
        "docs/configuration-reference.md"
      ]
    },
    "references": {
      "commands": ".agents/30-context/domains/cli-commands.md",
      "configuration": "docs/configuration-reference.md",
      "architecture": "docs/architecture.md"
    },
    "adrFolder": "docs/adr",
    "enumerations": [
      {
        "name": "modules",
        "find": "classes implementing IModule"
      },
      {
        "name": "commands",
        "find": "classes with a [Command] attribute or registered in a RootCommand/CommandApp"
      },
      {
        "name": "options",
        "find": "classes implementing IConfigSection (SectionName and init-only properties)"
      },
      {
        "name": "connectors",
        "find": "classes named *Source, *Target, *Connector or implementing ISourceEndpointInfo/ITargetEndpointInfo (ConnectorType)"
      }
    ],
    "dataClassification": "Never add real project names, organisation URLs, attachment paths or field values; use placeholders such as <project-name> and <org-url>.",
    "layout": {
      "guides": "docs",
      "context": ".agents/30-context",
      "guardrails": ".agents/20-guardrails"
    },
    "entryFiles": [
      ".agents/agents.md",
      ".github/copilot-instructions.md"
    ],
    "excluded": [
      ".agents/skills",
      ".github/agents",
      ".specify",
      "specs"
    ],
    "audiences": [
      "Agents/AI",
      "Operators",
      "Advanced Operators",
      "Contributors"
    ],
    "targetMap": ".agents/skills/nkda-archimprove-documentation/DOCUMENTATION-MAP.md",
    "closeChecks": [
      "All items in specs/<feature>/discrepancies.md are marked Resolved or N/A.",
      "If a new CLI command was added: the docs/cli-guide.md Commands table is updated and a .vscode/launch.json entry exists.",
      "analysis/pending-actions.md is reviewed and newly completed items are removed."
    ],
    "indexes": {
      "guardrails": ".agents/20-guardrails/README.md",
      "context": ".agents/90-index/context-index.md",
      "guides": "docs/README.md"
    },
    "terminology": ".agents/30-context/primers/terminology.md"
  },
  "speckit": {
    "featuresFolder": "specs",
    "preflight": "pwsh ./scripts/guardrails/validate-orchestrator.ps1",
    "gates": {
      "before": [
        "/nkda-core-tasks-architecture-compliance",
        "/speckit.superb.review",
        "/speckit.superb.tdd"
      ],
      "after": [
        "/nkda-core-implementation-architecture-compliance",
        "/nkda-core-definition-of-done",
        "/speckit.superb.verify"
      ]
    },
    "extensionsFile": ".specify/extensions.yml",
    "commandFolders": [
      ".agents/commands",
      ".agents/skills"
    ],
    "requiredHooks": [
      {
        "hook": "before_implement",
        "command": "speckit.superb.tdd"
      },
      {
        "hook": "after_implement",
        "command": "speckit.superb.verify"
      },
      {
        "hook": "after_tasks",
        "command": "speckit.superb.review"
      }
    ],
    "requiredArtefacts": [
      ".agents/commands/nkda-tddsn-autonomous.md",
      ".agents/commands/nkda-core-tasks-architecture-compliance.md",
      ".agents/commands/nkda-core-implementation-architecture-compliance.md",
      ".agents/skills/nkda-core-tasks-architecture-compliance/SKILL.md",
      ".agents/skills/nkda-core-implementation-architecture-compliance/SKILL.md"
    ]
  },
  "runtime": {
    "targets": [
      "net10",
      "net481"
    ],
    "boundary": ".agents/20-guardrails/core/runtime-compatibility-net10-net481.md",
    "constraints": [
      "TfsObjectModel COM interop must remain in net481-only projects.",
      "Shared abstractions must remain multi-targeted."
    ],
    "parity": "full"
  },
  "harness": {
    "catalogs": [
      {
        "file": ".agents/10-contracts/routing-catalog.yaml"
      },
      {
        "file": ".agents/00-entry/task-profiles.yaml"
      },
      {
        "file": ".agents/10-contracts/change-classes.yaml"
      },
      {
        "file": ".agents/10-contracts/consent-policy.yaml"
      },
      {
        "file": ".agents/10-contracts/surface-catalog.yaml"
      },
      {
        "file": ".agents/10-contracts/seam-catalog.yaml"
      }
    ],
    "routingCatalog": ".agents/10-contracts/routing-catalog.yaml",
    "taskProfiles": ".agents/00-entry/task-profiles.yaml",
    "adrDigest": {
      "adrFolder": "docs/adr",
      "file": ".agents/30-context/domains/decision-records-summary.md",
      "heading": "^## ADR (\\d{4})"
    },
    "contextIndex": {
      "file": ".agents/90-index/context-index.md",
      "domainsFolder": ".agents/30-context/domains"
    },
    "links": [
      {
        "target": ".agents/agents.md",
        "links": [
          "AGENTS.md",
          "CLAUDE.md",
          ".github/copilot-instructions.md"
        ]
      }
    ],
    "stubs": [
      {
        "stub": ".agents/40-stubs/controlplane.md",
        "folders": [
          "src/DevOpsMigrationPlatform.ControlPlane",
          "src/DevOpsMigrationPlatform.ControlPlaneHost"
        ]
      },
      {
        "stub": ".agents/40-stubs/cli.md",
        "folders": [
          "src/DevOpsMigrationPlatform.CLI.Migration"
        ]
      },
      {
        "stub": ".agents/40-stubs/infrastructure-agent.md",
        "folders": [
          "src/DevOpsMigrationPlatform.Infrastructure.Agent"
        ]
      },
      {
        "stub": ".agents/40-stubs/migration-agent.md",
        "folders": [
          "src/DevOpsMigrationPlatform.MigrationAgent"
        ]
      },
      {
        "stub": ".agents/40-stubs/net481.md",
        "folders": [
          "src/DevOpsMigrationPlatform.TfsMigrationAgent",
          "src/DevOpsMigrationPlatform.Infrastructure.TfsObjectModel"
        ]
      },
      {
        "stub": ".agents/40-stubs/simulated-connector.md",
        "folders": [
          "src/DevOpsMigrationPlatform.Infrastructure.Simulated"
        ]
      },
      {
        "stub": ".agents/40-stubs/storage-adapters.md",
        "folders": [
          "src/DevOpsMigrationPlatform.Infrastructure.Storage.FileSystem",
          "src/DevOpsMigrationPlatform.Infrastructure.Storage.AzureBlob"
        ]
      },
      {
        "stub": ".agents/40-stubs/azuredevops-connector.md",
        "folders": [
          "src/DevOpsMigrationPlatform.Infrastructure.AzureDevOps"
        ]
      },
      {
        "stub": ".agents/40-stubs/abstractions.md",
        "folders": [
          "src/DevOpsMigrationPlatform.Abstractions",
          "src/DevOpsMigrationPlatform.Abstractions.Agent",
          "src/DevOpsMigrationPlatform.Abstractions.ControlPlane",
          "src/DevOpsMigrationPlatform.Abstractions.Storage"
        ]
      },
      {
        "stub": ".agents/40-stubs/tests.md",
        "folders": [
          "tests"
        ]
      }
    ],
    "exemptFolders": [
      {
        "folder": "src/DevOpsMigrationPlatform.AppHost",
        "reason": "Aspire dev-host wiring only; no domain rules beyond the constitution."
      },
      {
        "folder": "src/DevOpsMigrationPlatform.Infrastructure",
        "reason": "Shared base infrastructure; governed by the core guardrails loaded via routing."
      },
      {
        "folder": "src/DevOpsMigrationPlatform.Infrastructure.ControlPlane",
        "reason": "Covered by the control-plane rules; the controlplane stub sits on the ControlPlane and Host projects."
      },
      {
        "folder": "src/DevOpsMigrationPlatform.SchemaGenerator",
        "reason": "Build-time tool; its one blocking rule is CI-enforced in main.yml."
      },
      {
        "folder": "src/DevOpsMigrationPlatform.ServiceDefaults",
        "reason": "Aspire service-defaults boilerplate; no migration logic."
      }
    ]
